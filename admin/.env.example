# Plantilla de configuración para Relax Tours
# Duplica este archivo, renombralo como .env y rellena tus datos reales.

# Credenciales del Panel de Administración
ADMIN_USER=""
ADMIN_PASS=""

# Credenciales del Servidor de Correo SMTP (Hostinger)
SMTP_USER=""
