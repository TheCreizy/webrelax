GEMINI_CHAT_MODEL="gemini-3.5-flash-lite"
GEMINI_CHAT_FALLBACK_MODEL="gemini-flash-lite-latest"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Credenciales de Supabase (Proyecto relaxtours-ai)
# SUPABASE_SECRET_KEY acepta la nueva Secret API Key (sb_secret_...) recomendada por Supabase o la legacy service_role key
