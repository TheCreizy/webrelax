# RELAX TOURS - Configuración Apache

# Proteger directorio admin
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Eliminar .php de la URL
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
    RewriteRule ^ %1 [R=301,L]

    # 2. Eliminar .html de la URL
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
    RewriteRule ^ %1 [R=301,L]

    # 3. Mapeo interno para archivos PHP
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*?)/?$ $1.php [L]

    # 4. Mapeo interno para archivos HTML
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*?)/?$ $1.html [L]

    # URLs amigables para blog (Mantiene compatibilidad anterior si se usa query string, pero ahora priorizamos slug limpio)
    # Mapea blog/mi-post a blog/post.html?slug=mi-post (Esto parece ser para un sistema diferente o legacy, voy a comentar la regla original y adaptar si es necesario)
    # RewriteRule ^blog/([^/.]+)/?$ blog/post.html?slug=$1 [L,QSA] # Comentado porque ahora usamos archivos estáticos generados

</IfModule>

# Compresión GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache de archivos estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Prevenir listado de directorios
Options -Indexes

# Proteger archivos sensibles
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
