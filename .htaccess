# RELAX TOURS - Configuración Apache Optimizada
Options -Indexes

# 1. FORZAR HTTPS (Robado del YouTuber, muy importante para seguridad)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Quitar la barra final (Trailing slash) de manera segura para Local y Web
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    # 2. Forzar HTTPS (Solo se activará en la web, en local no molestará si no tienes SSL)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 3. Limpieza de extensiones (.php y .html)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.(php|html) [NC]
    RewriteRule ^ %1 [L,R=301]

    # 4. Mapeo Interno (Ignorar archivos reales)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 5. Mapeo a PHP
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*?)/?$ $1.php [L]

    # 6. Mapeo a HTML
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*?)/?$ $1.html [L]
</IfModule>

# 4. COMPRESIÓN Y CACHÉ (Tu configuración de rendimiento, que está muy bien)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# 5. SEGURIDAD EXTRA (Protección de archivos y cabeceras)
<FilesMatch "^\.">
    # Proteger .env, .htaccess, .git, etc.
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevenir que tu web sea embebida en frames de otros (evita Clickjacking)
Header set X-Frame-Options "SAMEORIGIN"