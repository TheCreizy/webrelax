# RELAX TOURS - Configuración Apache Optimizada
Options -Indexes

# 1. FORZAR HTTPS (Robado del YouTuber, muy importante para seguridad)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # A. Forzar HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # B. Quitar barra final de URLs que NO son carpetas (Arregla el CSS roto)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # C. Limpieza de extensiones .php y .html
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.(php|html) [NC]
    RewriteRule ^ %1 [R=301,L]

    # D. Mapeo interno
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*?)/?$ $1.php [L]

    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*?)/?$ $1.html [L]
</IfModule>

# 4. COMPRESIÓN Y CACHÉ (Tu configuración de rendimiento, que está muy bien)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# 5. SEGURIDAD EXTRA (Protección de archivos y cabeceras)
<FilesMatch "^\.">
    # Proteger .env, .htaccess, .git, etc.
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevenir que tu web sea embebida en frames de otros (evita Clickjacking)
Header set X-Frame-Options "SAMEORIGIN"